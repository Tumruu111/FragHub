# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(48).toString('base64'))\""
ADMIN_SECRET_KEY="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# CORS: comma-separated sites allowed to call the API. Required in production.
ALLOWED_ORIGIN="http://localhost:5173"

# AWS / Cloudflare R2
AWS_REGION="auto"
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_BUCKET="your-bucket-name"
AWS_FILE_UPLOAD_TYPE="public"   # or "private" for signed URLs
# Public bucket address, needed for "public" uploads
AWS_PUBLIC_URL="https://pub-<id>.r2.dev/your-bucket-name"

# Shop address, used in links in emails
SITE_URL="http://localhost:5173"

# Server
PORT=3333
