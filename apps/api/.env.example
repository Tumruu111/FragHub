# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="generate with: node -e \"require('crypto').randomBytes(48).toString('base64') |> console.log\""
ADMIN_SECRET_KEY="generate with: node -e \"require('crypto').randomBytes(32).toString('base64') |> console.log\""

# CORS
ALLOWED_ORIGIN="http://localhost:5173"

# AWS / Cloudflare R2
AWS_REGION="auto"
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_BUCKET="your-bucket-name"
AWS_FILE_UPLOAD_TYPE="public"   # or "private" for signed URLs

# Server
PORT=3333
