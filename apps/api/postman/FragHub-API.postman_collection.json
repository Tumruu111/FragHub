{
  "info": {
    "name": "FragHub API",
    "description": "REST routes for the FragHub / Veritas Parfums API.\n\nSetup:\n1. Set `baseUrl` if not running on the default port 3333.\n2. Run **User Auth > Login** and **Admin > Login** — their scripts store `userToken` / `adminToken` automatically.\n3. Payment and admin requests then work without manual token copying.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3333" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "listingId", "value": "" }
  ],
  "item": [
    {
      "name": "User Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('userToken', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Payments (user)",
      "item": [
        {
          "name": "Create Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.paymentId) pm.collectionVariables.set('paymentId', json.paymentId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingIds\": [\"{{listingId}}\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/create", "host": ["{{baseUrl}}"], "path": ["api", "payments", "create"] }
          }
        },
        {
          "name": "Check Payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}/check", "host": ["{{baseUrl}}"], "path": ["api", "payments", "{{paymentId}}", "check"] }
          }
        },
        {
          "name": "Cancel Payment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "Payment Callback (QPay webhook, POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/callback", "host": ["{{baseUrl}}"], "path": ["api", "payments", "callback"] }
          }
        },
        {
          "name": "Payment Callback (QPay webhook, GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/callback?paymentId={{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "callback"],
              "query": [{ "key": "paymentId", "value": "{{paymentId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('adminToken', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/login", "host": ["{{baseUrl}}"], "path": ["api", "admin", "login"] }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPassword123!\",\n  \"secret\": \"<ADMIN_SECRET_KEY from .env>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/register", "host": ["{{baseUrl}}"], "path": ["api", "admin", "register"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/logout", "host": ["{{baseUrl}}"], "path": ["api", "admin", "logout"] }
          }
        },
        {
          "name": "Get All Listings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/lists", "host": ["{{baseUrl}}"], "path": ["api", "admin", "lists"] }
          }
        },
        {
          "name": "Create Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('listingId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dior Sauvage EDP\",\n  \"vibe\": \"fresh, spicy\",\n  \"status\": \"available\",\n  \"size\": \"100ml\",\n  \"picture\": \"listing-images/sauvage.webp\",\n  \"price\": 250000\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/create", "host": ["{{baseUrl}}"], "path": ["api", "admin", "create"] }
          }
        },
        {
          "name": "Delete Listing",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/delete/{{listingId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "delete", "{{listingId}}"] }
          }
        },
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "JPEG, PNG, or WEBP — max 5 MB" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/admin/files/upload", "host": ["{{baseUrl}}"], "path": ["api", "admin", "files", "upload"] }
          }
        },
        {
          "name": "Read File",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/files/example.webp", "host": ["{{baseUrl}}"], "path": ["api", "admin", "files", "example.webp"] }
          }
        }
      ]
    }
  ]
}
