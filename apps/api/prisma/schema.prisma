generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role    @default(User)

  orders    Order[]
  preorders Preorder[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A listing is one scent. Its opened bottle (volumeMl) fills subscription box
// decants; with a bottlePrice set, customers can also pre-order a full,
// sealed bottle of it, which we import for them.
model Listing {
  id        String         @id @default(uuid())
  status    ListingStatus  @default(in_stock)
  title     String
  vibe      String[]
  picture   String
  bottleMl  Int            @default(0) // full bottle size, e.g. 100
  volumeMl  Int            @default(0) // ml left to decant for boxes
  // Price of a full sealed bottle. Not sold as a bottle when empty.
  bottlePrice Decimal?     @db.Decimal(10,2)
  // What subscription boxes may use it for: a Base box is one designer and
  // one arabian decant, and "him" boxes only get masculine or unisex scents
  tier      ListingTier    @default(designer)
  scentFor  ScentFor       @default(unisex)

  orders    Order[]
  preorderItems PreorderItem[]
  boxItems  BoxItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String       @id @default(uuid())
  status          OrderStatus  @default(pending)

  userId          String
  user            User         @relation(fields: [userId], references: [id])

  listingId       String
  listing         Listing      @relation(fields: [listingId], references: [id])
  sizeMl          Int          @default(0)
  price           Decimal      @default(0) @db.Decimal(10,2) // price paid

  buyerConfirmed  Boolean      @default(false)

  // The subscription box it was sent in, whose subscription holds the
  // delivery details
  boxId           String?
  box             Box?         @relation(fields: [boxId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?
  cancelledAt     DateTime?

  @@index([boxId])
}

enum ListingTier {
  arabian
  designer
  niche
}

enum ScentFor {
  masculine
  feminine
  unisex
}

enum SubscriptionPlan {
  base
  premium
}

// Who the boxes are for: decides which scents may go in them
enum SubscriberFor {
  him
  her
}

enum SubscriptionStatus {
  pending   // signed up, first month not paid yet
  active
  cancelled
  waitlist  // asked for a plan that isn't open yet
}

enum BoxStatus {
  proposed  // picked automatically, waiting for the admin
  confirmed // ml taken from the bottles and orders created
}

// One per customer. A month's box is sent only once that month's invoice is
// paid; an unpaid month is simply skipped.
model Subscription {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id])
  plan            SubscriptionPlan
  forWhom         SubscriberFor
  status          SubscriptionStatus @default(pending)

  deliveryPhone   String
  deliveryAddress String
  deliveryNote    String?

  invoices        SubscriptionInvoice[]
  boxes           Box[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cancelledAt     DateTime?
}

// What one month costs. Paid by QPay like a checkout.
model SubscriptionInvoice {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  month          String        // "2026-12", in Ulaanbaatar time
  amount         Decimal       @db.Decimal(10,2)
  status         PaymentStatus @default(pending)
  qpayInvoiceId  String?
  qpayQrText     String?
  qpayQrImage    String?       @db.Text
  qpayUrls       Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([subscriptionId, month])
  @@index([month, status])
}

model Box {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  month          String
  status         BoxStatus    @default(proposed)
  items          BoxItem[]
  orders         Order[]
  createdAt      DateTime     @default(now())
  confirmedAt    DateTime?

  @@unique([subscriptionId, month])
  @@index([month])
}

// One decant slot in a box. listingId is empty when nothing in stock fitted,
// for the admin to fill.
model BoxItem {
  id        String      @id @default(uuid())
  boxId     String
  box       Box         @relation(fields: [boxId], references: [id], onDelete: Cascade)
  tier      ListingTier
  sizeMl    Int
  listingId String?
  listing   Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingId])
}

enum OrderStatus {
  pending
  completed
  cancelled
}

enum ListingStatus {
  in_stock
  out_of_order
}

enum Role {
  Admin
  User
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
}

// A full-bottle pre-order. The customer pays half up front; we order the
// bottles from our supplier, and once they arrive in UB the customer pays the
// rest and we deliver.
enum PreorderStatus {
  awaiting_deposit // placed, deposit not paid yet
  ordering         // deposit paid: we order it from the supplier
  arrived          // in UB: waiting for the rest to be paid
  paid             // fully paid: ready to deliver
  delivered
  cancelled
}

enum PreorderPaymentKind {
  deposit
  balance
}

model Preorder {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  status          PreorderStatus  @default(awaiting_deposit)
  total           Decimal         @db.Decimal(10,2)
  deposit         Decimal         @db.Decimal(10,2)

  deliveryPhone   String
  deliveryAddress String
  deliveryNote    String?

  items           PreorderItem[]
  payments        PreorderPayment[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  depositPaidAt   DateTime?
  arrivedAt       DateTime?
  paidAt          DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  @@index([userId])
  @@index([status])
}

// One bottle in a pre-order, with its title and price when it was placed
model PreorderItem {
  id         String    @id @default(uuid())
  preorderId String
  preorder   Preorder  @relation(fields: [preorderId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title      String
  bottleMl   Int
  price      Decimal   @db.Decimal(10,2)

  @@index([preorderId])
  @@index([listingId])
}

// The deposit or the rest, each paid by QPay
model PreorderPayment {
  id            String              @id @default(uuid())
  preorderId    String
  preorder      Preorder            @relation(fields: [preorderId], references: [id], onDelete: Cascade)
  kind          PreorderPaymentKind
  amount        Decimal             @db.Decimal(10,2)
  status        PaymentStatus       @default(pending)
  qpayInvoiceId String?
  qpayQrText    String?
  qpayQrImage   String?             @db.Text
  qpayUrls      Json?
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([preorderId, kind])
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
