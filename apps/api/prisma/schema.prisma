generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role    @default(User)

  orders    Order[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A listing is one bottle. Its ml are shared by the decant sizes: selling a
// 10ml decant takes 10ml out of volumeMl, which every size draws from.
model Listing {
  id        String         @id @default(uuid())
  status    ListingStatus  @default(in_stock)
  title     String
  vibe      String[]
  picture   String
  bottleMl  Int            @default(0) // full bottle size, e.g. 100
  volumeMl  Int            @default(0) // ml left to decant

  sizes     ListingSize[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The price of one decant size of a listing, e.g. 5ml for 18,000₮
model ListingSize {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sizeMl    Int
  price     Decimal  @db.Decimal(10,2)

  @@unique([listingId, sizeMl])
}

model Order {
  id              String       @id @default(uuid())
  status          OrderStatus  @default(pending)

  userId          String
  user            User         @relation(fields: [userId], references: [id])

  listingId       String
  listing         Listing      @relation(fields: [listingId], references: [id])
  sizeMl          Int          @default(0)
  price           Decimal      @default(0) @db.Decimal(10,2) // price paid

  buyerConfirmed  Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?
  cancelledAt     DateTime?
}

enum OrderStatus {
  pending
  completed
  cancelled
}

enum ListingStatus {
  in_stock
  out_of_order
}

enum Role {
  Admin
  User
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Decimal       @db.Decimal(10,2)
  status         PaymentStatus @default(pending)
  listingIds     String[]
  qpayInvoiceId  String?
  qpayQrText     String?
  qpayQrImage    String?       @db.Text
  qpayUrls       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}
model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
